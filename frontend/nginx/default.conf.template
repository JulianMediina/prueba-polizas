# Plantilla procesada por envsubst al iniciar el contenedor (imagen oficial de nginx).
# Variables: API_KEY, BACKEND_HOST, ORIGIN_SECRET (vacío en local = sin verificación de origen).

# IP real del cliente: CloudFront agrega la IP del visitante al final de X-Forwarded-For.
# Es seguro confiar en el header porque el security group solo admite tráfico de CloudFront.
real_ip_header X-Forwarded-For;
set_real_ip_from 0.0.0.0/0;
real_ip_recursive off;

limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_status 429;

# CloudFront envía X-Origin-Verify; cualquier otro origen recibe 403.
map $http_x_origin_verify $origen_invalido {
  default 1;
  "${ORIGIN_SECRET}" 0;
}

upstream backend {
  server ${BACKEND_HOST}:8080;
  keepalive 16;
}

server {
  listen 8080;
  server_name _;
  server_tokens off;
  root /usr/share/nginx/html;
  client_max_body_size 64k;

  include /etc/nginx/snippets/security-headers.conf;

  # Healthcheck del contenedor. El "if" de abajo se evalúa antes de elegir location,
  # así que el healthcheck también envía X-Origin-Verify (ver HEALTHCHECK del Dockerfile).
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  if ($origen_invalido) {
    return 403;
  }

  # BFF: el navegador llama a /api/* y nginx agrega la API key del lado del servidor.
  # La key nunca viaja al navegador ni aparece en el bundle JS.
  location /api/ {
    limit_req zone=api burst=40 nodelay;
    proxy_pass http://backend/;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Origin-Verify "";
    proxy_set_header x-api-key "${API_KEY}";
    proxy_hide_header X-Powered-By;
  }

  # API directa para integradores y evaluación con curl: el cliente debe enviar su propio x-api-key.
  location ~ ^/(polizas|riesgos|core-mock)(/|$) {
    limit_req zone=api burst=40 nodelay;
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Origin-Verify "";
  }

  location = /actuator/health {
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
  }

  # Assets con hash en el nombre: caché larga
  location ~* \.(?:js|css|woff2?|svg|ico|png)$ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # SPA: index.html nunca se cachea para que un despliegue nuevo se vea de inmediato
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
  }
}
