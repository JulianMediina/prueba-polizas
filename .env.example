# Copiar a .env y ajustar. El archivo .env NUNCA se versiona.

# API key que exige el header x-api-key. Para la evaluación el enunciado usa 123456.
API_KEY=cambiar-por-una-api-key

# Usuario dueño del esquema (lo usa Flyway para DDL)
DB_OWNER_USER=polizas_owner
DB_OWNER_PASSWORD=cambiar-owner

# Usuario de la aplicación (solo DML)
DB_APP_USER=polizas_app
DB_APP_PASSWORD=cambiar-app

DB_NAME=polizas
